# Copy this to .env.test and fill in real values. Never commit .env.test.
# Run tests from the tests/ directory: cd tests && npm test

# Override base URL if needed (defaults to https://fixernationeducation.com)
# PLAYWRIGHT_BASE_URL=https://fixernationeducation.com

# Admin account (the single FNE admin login)
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=

# Site-user accounts
# Licensed: a site_users row with an active license_seats registration
TEST_SITE_USER_EMAIL=
TEST_SITE_USER_PASSWORD=

# Unlicensed: a site_users row with no active license — used to verify gating
TEST_SITE_USER_UNLICENSED_EMAIL=
TEST_SITE_USER_UNLICENSED_PASSWORD=

# Morning Boost member: a newsletter_contacts row with an active/trialing contact_memberships entry
# (can be the same email as the licensed site user if that account also has a membership)
TEST_MEMBER_EMAIL=
TEST_MEMBER_PASSWORD=

# School admin portal: a site user with role='school_license_admin' and a school_license_admins record
TEST_SCHOOL_ADMIN_EMAIL=
TEST_SCHOOL_ADMIN_PASSWORD=

# Teacher portal: a site user linked to at least one classroom
TEST_TEACHER_EMAIL=
TEST_TEACHER_PASSWORD=

# Student: an existing student record (created via classroom join-code flow) with a username+PIN
TEST_STUDENT_USERNAME=
TEST_STUDENT_PIN=

# Parent portal
TEST_PARENT_EMAIL=
TEST_PARENT_PASSWORD=

# Accept-quote test tokens: a valid unexpired quote token, and an invalid one
TEST_QUOTE_VALID_TOKEN=
TEST_QUOTE_INVALID_TOKEN=does-not-exist

# Accept-quote test tokens: a valid unexpired quote token, and an invalid one
# Leave TEST_QUOTE_VALID_TOKEN blank to skip that one test.
TEST_QUOTE_VALID_TOKEN=
TEST_QUOTE_INVALID_TOKEN=does-not-exist

# Removable teacher: a site_user registered under the school admin's own
# purchase, used only by the "Remove Teacher" e2e test
TEST_REMOVABLE_TEACHER_EMAIL=
