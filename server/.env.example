PORT=3001
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fixernation
DB_PASSWORD=
DB_NAME=fixernation

SESSION_SECRET=change-me-to-a-long-random-string

# In development, Express also serves the static site files from the repo root
# so the whole thing can be tested at http://localhost:3001 without a separate server.
SERVE_STATIC=true

# Where uploaded images (book covers, etc.) are written to disk. In production this
# MUST be an absolute path inside public_html (e.g. /home/fixernat/public_html/uploads)
# so Apache/LiteSpeed can serve the files directly. UPLOADS_URL_PREFIX is the public
# URL path those files are reachable at.
UPLOADS_DIR=./uploads
UPLOADS_URL_PREFIX=/uploads/

# Absolute site URL, used to build the unsubscribe link embedded in sent campaign emails.
SITE_URL=https://fixernationeducation.com

# SMTP config for sending real email campaigns. Easiest option: create a mailbox in
# cPanel (Email Accounts) on this domain, then use its mail server settings here —
# usually SMTP_HOST=mail.fixernationeducation.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=the full email address, SMTP_PASSWORD=its mailbox password. A third-party
# service (SendGrid, Postmark, etc.) works the same way via its own SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
