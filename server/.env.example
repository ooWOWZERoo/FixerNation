PORT=3001
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fixernation
DB_PASSWORD=
DB_NAME=fixernation

SESSION_SECRET=change-me-to-a-long-random-string

# In development, Express also serves the static site files from the repo root
# so the whole thing can be tested at http://localhost:3001 without a separate server.
SERVE_STATIC=true
