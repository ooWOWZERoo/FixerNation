PORT=3001
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fixernation
DB_PASSWORD=
DB_NAME=fixernation

SESSION_SECRET=change-me-to-a-long-random-string

# In development, Express also serves the static site files from the repo root
# so the whole thing can be tested at http://localhost:3001 without a separate server.
SERVE_STATIC=true

# Where uploaded images (book covers, etc.) are written to disk. In production this
# MUST be an absolute path inside public_html (e.g. /home/fixernat/public_html/uploads)
# so Apache/LiteSpeed can serve the files directly. UPLOADS_URL_PREFIX is the public
# URL path those files are reachable at.
UPLOADS_DIR=./uploads
UPLOADS_URL_PREFIX=/uploads/
